export PKG_CONFIG_PATH="/opt/homebrew/opt/jpeg/lib/pkgconfig"
export PATH="$HOME/.local/bin":$PATH

export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvm
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# ZSH_THEME="powerlevel10k/powerlevel10k"
# ZSH_THEME="gozilla"
ZSH_THEME="robbyrussell"

plugins=(git zsh-autosuggestions web-search)

source $ZSH/oh-my-zsh.sh

alias v="nvim"
alias l="lsd --long"
alias at="tmux attach -t"
alias pip="pip3"
alias lg="lazygit"
alias ld="lazydocker"
alias python="python3"
alias jest_js="./node_modules/.bin/jest --config=./jest.config.js"
alias jest_cjs="./node_modules/.bin/jest --config=./jest.config.cjs"
alias jest_ts="./node_modules/.bin/jest --config=./jest.config.ts"
alias f="fzf | pbcopy"
alias vp='v "$(fzf)"'
alias vs='code "$(fzf)"'
alias test='yarn run test "$(fzf --query=.test)"'
alias tp='jest_js "$(fzf)"'
alias cat="bat"
alias cd="z"
alias lint='npx eslint --fix "$(fzf)"'
alias codex='cmatrix'
alias me='neofetch'
alias o='opencode'
alias evexi='evx'
alias zfzf='zed "$(fzf)"'

source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

source $HOME/.oh-my-zsh/plugins/calc/calc.plugin.zsh

# bun completions
[ -s "/Users/andrei/.bun/_bun" ] && source "/Users/andrei/.bun/_bun"

# fzf keybindings and completions
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# # dart
# export PATH="$(brew --prefix dart)/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
export PATH=$HOME/dev/flutter/bin:$PATH


eval "$(zoxide init zsh)"
eval "$(starship init zsh)"

# Added by Antigravity
export PATH="/Users/andrei/.antigravity/antigravity/bin:$PATH"

# Android platform-tools
export PATH="$HOME/.platform-tools:$PATH"

# Enable programmable sdb completion features.
if [ -f ~/.sdb/.sdb-completion.bash ]; then
 source ~/.sdb/.sdb-completion.bash
fi

